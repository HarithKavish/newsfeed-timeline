<?xml version="1.0" encoding="utf-8"?>
<!--
  One development in the story, with the outlets that corroborated it. The
  engine writes the headline text as a continuing log entry, so these read as
  a narrative down the page rather than as a pile of scraped headlines.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_grid"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/occurred"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_meta"
        android:textStyle="bold"
        tools:text="30 Sep, 21:33" />

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/text"
        android:textSize="@dimen/text_body"
        tools:text="The court ordered media outlets to remove the clips." />

    <LinearLayout
        android:id="@+id/sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="vertical" />

</LinearLayout>
